<!DOCTYPE html>
.footer {
    margin-top: 20px;
    font-size: 12px;
    color: #666;
}
</style>
</head>

<body>

<h1>Oracle RMAN Enterprise Report</h1>

<h2>Resumo da Execução</h2>

<table>
<tr>
    <th>Data</th>
    <th>Tipo Backup</th>
    <th>Total Hosts</th>
</tr>
<tr>
    <td>{{ report_date }}</td>
    <td>{{ backup_type }}</td>
    <td>{{ ansible_play_hosts | length }}</td>
</tr>
</table>

<br>

<h2>Detalhamento</h2>

<table>
<tr>
    <th>Host</th>
    <th>SID</th>
    <th>Status</th>
    <th>Log</th>
</tr>

{% for item in report_data %}
<tr class="{{ item.status_class }}">
    <td>{{ item.host }}</td>
    <td>{{ item.sid }}</td>
    <td>{{ item.status }}</td>
    <td>{{ item.log }}</td>
</tr>
{% endfor %}

</table>

<div class="footer">
Relatório gerado automaticamente pelo AWX + Ansible + Oracle RMAN
</div>

</body>
</html>
